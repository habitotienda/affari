PORT=8000

# Supabase (PostgreSQL): Project Settings > Database > Connection string. Si tu red no tiene IPv6, usá la cadena "Session pooler".
# Para desarrollo local sin Supabase: sqlite:///affari.db
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.TU_PROYECTO.supabase.co:5432/postgres

SECRET_KEY=generar-una-clave-larga-y-aleatoria
JWT_SECRET=generar-otra-clave-larga-y-aleatoria

# Asistente IA (Gemini). Una o varias claves separadas por coma (https://aistudio.google.com/apikey).
GEMINI_API_KEYS=
GEMINI_MODELS=gemini-2.5-flash,gemini-flash-latest
# Gemini: 0 = sin "thinking" (más rápido, por defecto); un número lo limita; auto = valor del modelo
GEMINI_THINKING_BUDGET=0

# Ingreso con Google (opcional). Google Cloud Console > APIs y servicios > Credenciales > ID de cliente de OAuth (Aplicación web).
# Agregá tu dominio y http://localhost:8000 en "Orígenes de JavaScript autorizados". Sin esta variable el botón de Google no aparece.
GOOGLE_CLIENT_ID=
# Zona horaria de los horarios de atención (por defecto Argentina)
APP_TZ=America/Argentina/Buenos_Aires

# ---- Planes y cobros ----
# Correos con acceso total gratis de por vida (plan Negocio permanente), separados por coma
ADMIN_VIP_EMAILS=correo1@gmail.com,correo2@gmail.com
# Mercado Pago > Tus integraciones > Credenciales > Access Token (producción; para probar, el de TEST)
MP_ACCESS_TOKEN=
# Opcional: «clave secreta» de Webhooks en Mercado Pago. Si la cargás, se valida la firma de cada aviso
MP_WEBHOOK_SECRET=
# URL pública con https donde corre Affari (para volver del pago y recibir el webhook). Sin barra final
APP_BASE_URL=https://tu-dominio.com
TRIAL_DAYS=7
PLAN_DAYS=30
PRO_PRICE=9900
NEGOCIO_PRICE=19900

# ---- Render ----
# Render define PORT y RENDER_EXTERNAL_URL solos. En local: DEV=1 activa el autoreload
DEV=
